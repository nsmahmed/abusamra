      "local": "data/processed/local/barriers.json"
    },
    "roads": {
      "purpose": "Linear roads, including each mapped Salwa Road carriageway through the port and the approach and exit. One way is one drawn carriageway, not a guess at lane count.",
      "features": 392,
      "wgs84": "data/processed/wgs84/roads.geojson",
      "local": "data/processed/local/roads.json"
    },
    "road_areas": {
      "purpose": "Road or service-area polygons.",
